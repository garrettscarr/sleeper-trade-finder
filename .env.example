# Postgres connection string (Neon / Supabase / Vercel Postgres)
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sleeper_trade_finder?sslmode=require"

# Required in production — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: public site URL (handy for docs / absolute invite links)
# APP_URL="https://your-app.vercel.app"
